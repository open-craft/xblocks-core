{
  "name": "openedx_flashcards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:watch": "concurrently -k -n tsc,vite -c blue,magenta \"tsc -b --watch --preserveWatchOutput\" \"vite build --watch\"",
    "test": "vitest run",
    "test-ci": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "format": "oxfmt",
    "i18n_extract": "node scripts/extract-translations.ts"
  },
  "dependencies": {
    "@openedx/paragon": "^23.23.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^10.2.2"
  },
  "devDependencies": {
    "@formatjs/cli-lib": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.10"
  }
}
